# ──────────────────────────────────────────────────────────────────────────────
# terraform.tfvars.example
# Copy this to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit real values.
# ──────────────────────────────────────────────────────────────────────────────

aws_region    = "ap-south-1"
key_pair_name = "my-aws-key"        # name of your key pair in EC2 console
your_ip       = "203.0.113.5/32"    # your public IP — run: curl ifconfig.me

# Optional overrides (defaults are set in variables.tf)
# ami_id                  = "ami-0f58b397bc5c1f2e8"
# gateway_instance_type   = "t2.micro"
# engine_instance_type    = "t2.micro"
# inference_instance_type = "t2.medium"
